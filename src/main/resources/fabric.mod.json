{
	"schemaVersion": 1,
	"id": "fpv20",
	"version": "${version}",
	"name": "fpv20",
	"description": "fpv mod for 1.20.1(and also 1.20 ~ 1.21.5)",
	"authors": [
		"iung"
	],
	"contact": {
		"homepage": "https://github.com/wefcdse/fpv20",
		"sources": "https://github.com/wefcdse/fpv20"
	},
	"license": "GPL-3.0",
	"icon": "assets/fpv20/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.iung.fpv20.Fpv20"
		],
		"client": [
			"com.iung.fpv20.Fpv20Client"
		],
		"fabric-datagen": [
			"com.iung.fpv20.Fpv20DataGenerator"
		]
	},
	"mixins": [
		"fpv20.mixins.json",
		{
			"config": "fpv20.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.14",
		"minecraft": ">=1.21.6",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	},
	"custom": {
		"loom:injected_interfaces": {
			"net/minecraft/entity/LivingEntity": ["com/iung/fpv20/mixin_utils/IsFlying"]
		}
	}
}